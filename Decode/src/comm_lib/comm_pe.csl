// Batched KV-head-scoped reduce over all gqa_group_size groups' scores at once.
// Reduces gqa_group_size X-reduce synchronizations to 1.
fn all_reduce_bsz_g_seq_len_kv_head_scoped(px_in_kv_head: i16, quotient_x_in_kv_head: i16, remainder_pe_id: i16, vector_buf_ptr: [*]f16) void {
    vector_buf_dsd_bsz_g_seq_len = @set_dsd_base_addr(vector_buf_dsd_bsz_g_seq_len, vector_buf_ptr);
    @load_to_dsr(vector_buf_dsr, vector_buf_dsd_bsz_g_seq_len);

    // Phase-1 reduce: within-group (identical to global reduce phase 1)
    if (remainder_pe_id == root_1st_phase) {
        if (root_1st_phase < pe_num_p_group - 1) {
            @faddh(vector_buf_dsd_bsz_g_seq_len, reduce_1st_0_recv_bsz_g_seq_len, vector_buf_dsr);
        }
        @faddh(vector_buf_dsd_bsz_g_seq_len, reduce_1st_1_recv_bsz_g_seq_len, vector_buf_dsr);
    } else if (remainder_pe_id > root_1st_phase) {
        if (remainder_pe_id % 2 == 0) {
            if (remainder_pe_id == pe_num_p_group - 1) {
                @fmovh(reduce_1st_0_send_bsz_g_seq_len, vector_buf_dsr);
            } else {
                @faddh(reduce_1st_0_send_bsz_g_seq_len, reduce_1st_1_recv_bsz_g_seq_len, vector_buf_dsr);
            }
        } else {
            if (remainder_pe_id == pe_num_p_group - 1) {
                @fmovh(reduce_1st_1_send_bsz_g_seq_len, vector_buf_dsr);
            } else {
                @faddh(reduce_1st_1_send_bsz_g_seq_len, reduce_1st_0_recv_bsz_g_seq_len, vector_buf_dsr);
            }
        }
    } else {
        if (remainder_pe_id % 2 == 0) {
            if (remainder_pe_id == 0) {
                @fmovh(reduce_1st_1_send_bsz_g_seq_len, vector_buf_dsr);
            } else {
                @faddh(reduce_1st_1_send_bsz_g_seq_len, reduce_1st_0_recv_bsz_g_seq_len, vector_buf_dsr);
            }
        } else {
            @faddh(reduce_1st_0_send_bsz_g_seq_len, reduce_1st_1_recv_bsz_g_seq_len, vector_buf_dsr);
        }
    }

    // Phase-2 reduce: kv-head-scoped (uses X_KV_HEAD_2nd_RD routes; skipped when groups_per_kv_head == 1)
    if (groups_per_kv_head > 1) {
        if (px_in_kv_head == root_kv_head_2nd_in_head) {
            if (root_kv_head_2nd_in_head < pes_p_kv_head - pe_num_p_group) {
                @faddh(vector_buf_dsd_bsz_g_seq_len, reduce_2nd_0_recv_bsz_g_seq_len, vector_buf_dsr);
            }
            @faddh(vector_buf_dsd_bsz_g_seq_len, reduce_2nd_1_recv_bsz_g_seq_len, vector_buf_dsr);
        } else if (px_in_kv_head > root_kv_head_2nd_in_head) {
            if (remainder_pe_id == root_1st_phase) {
                if (px_in_kv_head > pes_p_kv_head - pe_num_p_group - 1) {
                    if (quotient_x_in_kv_head % 2 == 0) {
                        @fmovh(reduce_2nd_0_send_bsz_g_seq_len, vector_buf_dsr);
                    } else {
                        @fmovh(reduce_2nd_1_send_bsz_g_seq_len, vector_buf_dsr);
                    }
                } else {
                    if (quotient_x_in_kv_head % 2 == 0) {
                        @faddh(reduce_2nd_0_send_bsz_g_seq_len, reduce_2nd_1_recv_bsz_g_seq_len, vector_buf_dsr);
                    } else {
                        @faddh(reduce_2nd_1_send_bsz_g_seq_len, reduce_2nd_0_recv_bsz_g_seq_len, vector_buf_dsr);
                    }
                }
            }
        } else {
            if (remainder_pe_id == root_1st_phase) {
                if (px_in_kv_head < pe_num_p_group) {
                    @fmovh(reduce_2nd_1_send_bsz_g_seq_len, vector_buf_dsr);
                } else {
                    if (quotient_x_in_kv_head % 2 == 0) {
                        @faddh(reduce_2nd_1_send_bsz_g_seq_len, reduce_2nd_0_recv_bsz_g_seq_len, vector_buf_dsr);
                    } else {
                        @faddh(reduce_2nd_0_send_bsz_g_seq_len, reduce_2nd_1_recv_bsz_g_seq_len, vector_buf_dsr);
                    }
                }
            }
        }
    }

    // Broadcast (kv-head-scoped: X_KV_HEAD_BD routes in effect)
    if (px_in_kv_head == root_kv_head_2nd_in_head) {
        @mov16(bdcast_send_bsz_g_seq_len, vector_buf_dsr);
    } else {
        @mov16(vector_buf_dsd_bsz_g_seq_len, bdcast_recv_bsz_g_seq_len);
    }
}

// Variable-length version: used in Phase 3 where iter_num grows at runtime.
// Extent = gqa_group_size * bsz * var_iter_num (runtime value).
fn all_reduce_bsz_g_var_seq_len_kv_head_scoped(px_in_kv_head: i16, quotient_x_in_kv_head: i16, remainder_pe_id: i16, vector_buf_ptr: [*]f16, var_iter_num: i16) void {
    const len = @as(u16, gqa_group_size * bsz * var_iter_num);
    var var_reduce_1st_0_recv_bsz_g_seq_len = @set_dsd_length(reduce_1st_0_recv_bsz_g_seq_len, len);
    var var_reduce_1st_1_recv_bsz_g_seq_len = @set_dsd_length(reduce_1st_1_recv_bsz_g_seq_len, len);
    var var_reduce_2nd_0_recv_bsz_g_seq_len = @set_dsd_length(reduce_2nd_0_recv_bsz_g_seq_len, len);
    var var_reduce_2nd_1_recv_bsz_g_seq_len = @set_dsd_length(reduce_2nd_1_recv_bsz_g_seq_len, len);
    var var_reduce_1st_0_send_bsz_g_seq_len = @set_dsd_length(reduce_1st_0_send_bsz_g_seq_len, len);
    var var_reduce_1st_1_send_bsz_g_seq_len = @set_dsd_length(reduce_1st_1_send_bsz_g_seq_len, len);
    var var_reduce_2nd_0_send_bsz_g_seq_len = @set_dsd_length(reduce_2nd_0_send_bsz_g_seq_len, len);
    var var_reduce_2nd_1_send_bsz_g_seq_len = @set_dsd_length(reduce_2nd_1_send_bsz_g_seq_len, len);
    var var_bdcast_recv_bsz_g_seq_len = @set_dsd_length(bdcast_recv_bsz_g_seq_len, len);
    var var_bdcast_send_bsz_g_seq_len = @set_dsd_length(bdcast_send_bsz_g_seq_len, len);

    vector_buf_dsd_bsz_g_seq_len = @set_dsd_base_addr(vector_buf_dsd_bsz_g_seq_len, vector_buf_ptr);
    vector_buf_dsd_bsz_g_seq_len = @set_dsd_length(vector_buf_dsd_bsz_g_seq_len, len);
    @load_to_dsr(vector_buf_dsr, vector_buf_dsd_bsz_g_seq_len);

    // Phase-1 reduce: within-group (identical to fixed-length version)
    if (remainder_pe_id == root_1st_phase) {
        if (root_1st_phase < pe_num_p_group - 1) {
            @faddh(vector_buf_dsd_bsz_g_seq_len, var_reduce_1st_0_recv_bsz_g_seq_len, vector_buf_dsr);
        }
        @faddh(vector_buf_dsd_bsz_g_seq_len, var_reduce_1st_1_recv_bsz_g_seq_len, vector_buf_dsr);
    } else if (remainder_pe_id > root_1st_phase) {
        if (remainder_pe_id % 2 == 0) {
            if (remainder_pe_id == pe_num_p_group - 1) {
                @fmovh(var_reduce_1st_0_send_bsz_g_seq_len, vector_buf_dsr);
            } else {
                @faddh(var_reduce_1st_0_send_bsz_g_seq_len, var_reduce_1st_1_recv_bsz_g_seq_len, vector_buf_dsr);
            }
        } else {
            if (remainder_pe_id == pe_num_p_group - 1) {
                @fmovh(var_reduce_1st_1_send_bsz_g_seq_len, vector_buf_dsr);
            } else {
                @faddh(var_reduce_1st_1_send_bsz_g_seq_len, var_reduce_1st_0_recv_bsz_g_seq_len, vector_buf_dsr);
            }
        }
    } else {
        if (remainder_pe_id % 2 == 0) {
            if (remainder_pe_id == 0) {
                @fmovh(var_reduce_1st_1_send_bsz_g_seq_len, vector_buf_dsr);
            } else {
                @faddh(var_reduce_1st_1_send_bsz_g_seq_len, var_reduce_1st_0_recv_bsz_g_seq_len, vector_buf_dsr);
            }
        } else {
            @faddh(var_reduce_1st_0_send_bsz_g_seq_len, var_reduce_1st_1_recv_bsz_g_seq_len, vector_buf_dsr);
        }
    }

    // Phase-2 reduce: kv-head-scoped (skipped when groups_per_kv_head == 1)
    if (groups_per_kv_head > 1) {
        if (px_in_kv_head == root_kv_head_2nd_in_head) {
            if (root_kv_head_2nd_in_head < pes_p_kv_head - pe_num_p_group) {
                @faddh(vector_buf_dsd_bsz_g_seq_len, var_reduce_2nd_0_recv_bsz_g_seq_len, vector_buf_dsr);
            }
            @faddh(vector_buf_dsd_bsz_g_seq_len, var_reduce_2nd_1_recv_bsz_g_seq_len, vector_buf_dsr);
        } else if (px_in_kv_head > root_kv_head_2nd_in_head) {
            if (remainder_pe_id == root_1st_phase) {
                if (px_in_kv_head > pes_p_kv_head - pe_num_p_group - 1) {
                    if (quotient_x_in_kv_head % 2 == 0) {
                        @fmovh(var_reduce_2nd_0_send_bsz_g_seq_len, vector_buf_dsr);
                    } else {
                        @fmovh(var_reduce_2nd_1_send_bsz_g_seq_len, vector_buf_dsr);
                    }
                } else {
                    if (quotient_x_in_kv_head % 2 == 0) {
                        @faddh(var_reduce_2nd_0_send_bsz_g_seq_len, var_reduce_2nd_1_recv_bsz_g_seq_len, vector_buf_dsr);
                    } else {
                        @faddh(var_reduce_2nd_1_send_bsz_g_seq_len, var_reduce_2nd_0_recv_bsz_g_seq_len, vector_buf_dsr);
                    }
                }
            }
        } else {
            if (remainder_pe_id == root_1st_phase) {
                if (px_in_kv_head < pe_num_p_group) {
                    @fmovh(var_reduce_2nd_1_send_bsz_g_seq_len, vector_buf_dsr);
                } else {
                    if (quotient_x_in_kv_head % 2 == 0) {
                        @faddh(var_reduce_2nd_1_send_bsz_g_seq_len, var_reduce_2nd_0_recv_bsz_g_seq_len, vector_buf_dsr);
                    } else {
                        @faddh(var_reduce_2nd_0_send_bsz_g_seq_len, var_reduce_2nd_1_recv_bsz_g_seq_len, vector_buf_dsr);
                    }
                }
            }
        }
    }

    // Broadcast (kv-head-scoped: X_KV_HEAD_BD routes in effect)
    if (px_in_kv_head == root_kv_head_2nd_in_head) {
        @mov16(var_bdcast_send_bsz_g_seq_len, vector_buf_dsr);
    } else {
        @mov16(vector_buf_dsd_bsz_g_seq_len, var_bdcast_recv_bsz_g_seq_len);
    }
}

fn all_reduce_bsz_dim(pe_id: i16, quotient_pe_id: i16, remainder_pe_id: i16, vector_buf_ptr: [*]f16) void {
    vector_buf_dsd_bsz_dim = @set_dsd_base_addr(vector_buf_dsd_bsz_dim, vector_buf_ptr);
    @load_to_dsr(vector_buf_dsr, vector_buf_dsd_bsz_dim);

    // 1st phase reduce
    if (remainder_pe_id == root_1st_phase) {
        if (root_1st_phase < pe_num_p_group - 1) {
            @faddh(vector_buf_dsd_bsz_dim, reduce_1st_0_recv_bsz_dim, vector_buf_dsr);
        }
        @faddh(vector_buf_dsd_bsz_dim, reduce_1st_1_recv_bsz_dim, vector_buf_dsr);
    } else if (remainder_pe_id > root_1st_phase) {
        if (remainder_pe_id % 2 == 0) {
            if (remainder_pe_id == pe_num_p_group - 1) {
                @fmovh(reduce_1st_0_send_bsz_dim, vector_buf_dsr);
            } else {
                @faddh(reduce_1st_0_send_bsz_dim, reduce_1st_1_recv_bsz_dim, vector_buf_dsr);
            }
        } else {
            // remainder_pe_id % 2 == 1
            if (remainder_pe_id == pe_num_p_group - 1) {
                @fmovh(reduce_1st_1_send_bsz_dim, vector_buf_dsr);
            } else {
                @faddh(reduce_1st_1_send_bsz_dim, reduce_1st_0_recv_bsz_dim, vector_buf_dsr);
            }
        }
    } else {
        // remainder_pe_id < root_1st_phase
        if (remainder_pe_id % 2 == 0) {
            if (remainder_pe_id == 0) {
                @fmovh(reduce_1st_1_send_bsz_dim, vector_buf_dsr);
            } else {
                @faddh(reduce_1st_1_send_bsz_dim, reduce_1st_0_recv_bsz_dim, vector_buf_dsr);
            }
        } else {
            // remainder_pe_id never be 0
            @faddh(reduce_1st_0_send_bsz_dim, reduce_1st_1_recv_bsz_dim, vector_buf_dsr);
        }
    }

    // 2nd phase reduce
    if (pe_id == root_2nd_phase) {
        if (root_2nd_phase < P - pe_num_p_group) {
            @faddh(vector_buf_dsd_bsz_dim, reduce_2nd_0_recv_bsz_dim, vector_buf_dsr);
        }
        @faddh(vector_buf_dsd_bsz_dim, reduce_2nd_1_recv_bsz_dim, vector_buf_dsr);
    } else if (pe_id > root_2nd_phase) {
        if (remainder_pe_id == root_1st_phase) {
            if (pe_id > P - pe_num_p_group - 1) {
                if (quotient_pe_id % 2 == 0) {
                    @fmovh(reduce_2nd_0_send_bsz_dim, vector_buf_dsr);
                } else {
                    @fmovh(reduce_2nd_1_send_bsz_dim, vector_buf_dsr);
                }
            } else {
                if (quotient_pe_id % 2 == 0) {
                    @faddh(reduce_2nd_0_send_bsz_dim, reduce_2nd_1_recv_bsz_dim, vector_buf_dsr);
                } else {
                    @faddh(reduce_2nd_1_send_bsz_dim, reduce_2nd_0_recv_bsz_dim, vector_buf_dsr);
                }
            }
        }
    } else {
        if (remainder_pe_id == root_1st_phase) {
            if (pe_id < pe_num_p_group) {
                @fmovh(reduce_2nd_1_send_bsz_dim, vector_buf_dsr);
            } else {
                if (quotient_pe_id % 2 == 0) {
                    @faddh(reduce_2nd_1_send_bsz_dim, reduce_2nd_0_recv_bsz_dim, vector_buf_dsr);
                } else {
                    @faddh(reduce_2nd_0_send_bsz_dim, reduce_2nd_1_recv_bsz_dim, vector_buf_dsr);
                }
            }
        }
    }

    // Broadcast
    if (pe_id == root_2nd_phase) {
        @mov16(bdcast_send_bsz_dim, vector_buf_dsr);
    } else {
        @mov16(vector_buf_dsd_bsz_dim, bdcast_recv_bsz_dim);
    }
}

